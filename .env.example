# Copy this to .env.local and fill in real values. .env.local is gitignored — never commit real secrets.

# Supabase (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-side only, never expose to the browser, never commit
SUPABASE_SERVICE_ROLE_KEY=

# Resend (Settings → API Keys in the Resend dashboard)
RESEND_API_KEY=

# Semaphore (existing account per CLAUDE.md — SMS OTP + notifications)
SEMAPHORE_API_KEY=
